# Copie este archivo como .env y cambie los valores.
# Conexión a MySQL:  mysql+pymysql://USUARIO:CONTRASEÑA@localhost:3306/NOMBRE_BD
DATABASE_URL=mysql+pymysql://root:su_contraseña@localhost:3306/crm_db

# Claves secretas: genere cada una con
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave
JWT_SECRET_KEY=cambie-esta-otra-clave

# Dirección del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Opcional
PORT=5001
DEBUG_MODE=False
